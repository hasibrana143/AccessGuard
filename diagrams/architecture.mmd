graph LR
    subgraph CLIENTS["Clients"]
        WebApp["Web App<br/>(Next.js)"]
        PublicAPI["Public API<br/>(REST)"]
        Webhooks["Webhooks<br/>(GitHub, Stripe)"]
    end

    subgraph EDGE["Edge / Middleware"]
        Middleware["Next.js Middleware<br/>Auth · RateLimit · i18n · Flags · CORS"]
    end

    subgraph GATEWAY["Gateway Layer"]
        BFF["BFF Layer<br/>Server Components<br/>Data Fetching · Auth"]
        APIGateway["API Gateway<br/>REST Routes<br/>Validation · RBAC · Mutations"]
        WebhookHandler["Webhook Handlers<br/>GitHub · Stripe · SCIM"]
    end

    subgraph DOMAIN["Domain Services"]
        ScannerSvc["Scanner Service<br/>Puppeteer + axe-core"]
        RemediationSvc["Remediation Service<br/>LLM + Template Fallback"]
        ComplianceSvc["Compliance Service<br/>PDF · VPAT · Executive"]
        SchedulerSvc["Scheduler Service<br/>Cron · Scheduled Scans"]
        NotificationSvc["Notification Service<br/>Email · Push · In-App"]
    end

    subgraph DATA["Data Layer"]
        Repo["Repository Layer<br/>Prisma · Org-Scoped · UoW"]
        DB[("PostgreSQL<br/>Multi-tenant · RLS")]
        Redis[("Redis<br/>Cache · Queue · Pub/Sub")]
    end

    subgraph EXTERNAL["External Services"]
        GitHubAPI["GitHub API"]
        StripeAPI["Stripe"]
        ResendAPI["Resend Email"]
        NVIDIANIM["NVIDIA NIM<br/>(AI Remediation)"]
    end

    %% Client connections
    WebApp --> Middleware
    PublicAPI --> Middleware
    Webhooks --> Middleware

    %% Edge to Gateway
    Middleware --> BFF
    Middleware --> APIGateway
    Middleware --> WebhookHandler

    %% Gateway to Domain
    BFF --> Repo
    APIGateway --> ScannerSvc
    APIGateway --> RemediationSvc
    APIGateway --> ComplianceSvc
    APIGateway --> SchedulerSvc
    WebhookHandler --> SchedulerSvc

    %% Domain to Data
    ScannerSvc --> Repo
    RemediationSvc --> Repo
    ComplianceSvc --> Repo
    SchedulerSvc --> Repo
    NotificationSvc --> Redis

    %% Repo to DB/Redis
    Repo --> DB
    Repo --> Redis

    %% Domain to External
    ScannerSvc --> NVIDIANIM
    RemediationSvc --> NVIDIANIM
    SchedulerSvc --> GitHubAPI
    ComplianceSvc --> GitHubAPI
    NotificationSvc --> ResendAPI
    WebhookHandler --> StripeAPI
    WebhookHandler --> GitHubAPI

    %% Styling
    classDef client fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
    classDef edge fill:#fff3e0,stroke:#e65100,stroke-width:2px;
    classDef gateway fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px;
    classDef domain fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
    classDef data fill:#fce4ec,stroke:#c2185b,stroke-width:2px;
    classDef external fill:#f1f8e9,stroke:#33691e,stroke-width:2px,stroke-dasharray: 5 5;

    class WebApp,PublicAPI,Webhooks client;
    class Middleware edge;
    class BFF,APIGateway,WebhookHandler gateway;
    class ScannerSvc,RemediationSvc,ComplianceSvc,SchedulerSvc,NotificationSvc domain;
    class Repo,DB,Redis data;
    class GitHubAPI,StripeAPI,ResendAPI,NVIDIANIM external;