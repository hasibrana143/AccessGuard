# AccessGuard — Environment Variables

# --- Database ---
# Local SQLite (dev only):
# DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
DATABASE_URL="postgresql://accessguard:accessguard_secret@localhost:5432/accessguard"

# --- Auth ---
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-64-hex"
NEXTAUTH_URL="http://localhost:3000"

# --- GitHub OAuth ---
GITHUB_ID=""
GITHUB_SECRET=""
# GitHub App webhook (optional; powers /api/github/webhook install sync)
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_APP_ID=""
# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="AccessGuard <noreply@accessguard.io>"
# --- AI Remediation (Zero-Budget Resilient Mesh: OpenRouter Free + NVIDIA NIM Free) ---
# Primary Free Provider: OpenRouter (free tier models with :free tag, e.g. llama-3.3-70b:free, qwen-2.5-coder:free)
OPENROUTER_API_KEY=""
# Secondary Free Provider: NVIDIA NIM (1,000 free developer credits at https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=""
# Provider failover priority: "openrouter,nvidia" (default) or "nvidia,openrouter"
AI_PROVIDER_PRIORITY="openrouter,nvidia"
# Set to "true" to lock all token accounting to $0.00 USD
AI_FREE_TIER="true"
# Optional single model override (defaults to auto-rotating free mesh)
AI_API_KEY=""
AI_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_MODEL="meta/llama-3.3-70b-instruct"
# --- Stripe Price IDs ---
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=""
NEXT_PUBLIC_STRIPE_GROWTH_PRICE_ID=""
NEXT_PUBLIC_STRIPE_AGENCY_PRICE_ID=""

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=""
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=""

# --- Scheduler ---
SCHEDULER_API_KEY="generate-a-random-secret"

# --- Retention (days; daemon sweep, 24h interval) ---
RETENTION_SCANS_DAYS=""
RETENTION_AUDIT_DAYS=""
RETENTION_AUTH_DAYS=""
RETENTION_SWEEP_INTERVAL_HOURS=""

# --- Scan workers (see docs/devops/SCALING.md) ---
SCAN_WORKER_CONCURRENCY=""
DISABLE_BACKGROUND_WORKERS=""

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Sentry (Error Tracking) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- PostHog (Product Analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# --- PagerDuty (Incident Alerting) ---
PAGERDUTY_ROUTING_KEY=""

# --- App Metadata ---
# Injected by CI as the git SHA in deployments; defaults to "dev" locally
APP_VERSION=""

# --- Feature Flags ---
# Override any flag at startup: FF_SCANNER_BROWSER=0 disables browser scanner
# FLAG_CACHE_TTL=300

# --- Security ---
ALLOWED_ORIGINS="http://localhost:3000,https://accessguard.io"

# --- Logging ---
LOG_LEVEL="info"
