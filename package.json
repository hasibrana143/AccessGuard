{
  "name": "accessguard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node -e \"const fs=require('fs');fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});fs.cpSync('public','.next/standalone/public',{recursive:true})\"",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:constraints": "prisma db execute --schema prisma/schema.prisma --file prisma/check-constraints.sql",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright test --project=setup",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push:dev": "prisma db push",
    "db:push:prod": "echo 'WARNING: Use prisma migrate deploy instead. db push can cause data loss.' && exit 1",
    "db:backup": "node scripts/db-backup.mjs backup",
    "db:backup:prune": "node scripts/db-backup.mjs backup --prune",
    "db:restore": "node scripts/db-backup.mjs restore"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
