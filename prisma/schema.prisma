generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  plan                 String             @default("starter")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  settings             String             @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  auditLogs            AuditLog[]
  githubConnections    GithubConnection[]
  projects             Project[]
  users                User[]
}

model User {
  id           String       @id @default(cuid())
  orgId        String
  email        String       @unique
  name         String?
  password     String?
  role         String       @default("member")
  avatar       String?
  githubToken  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Project {
  id                String       @id @default(cuid())
  orgId             String
  name              String
  url               String
  description       String?
  crawlConfig       String       @default("{\"maxPages\":100,\"excludePaths\":[],\"includeSubdomains\":false}")
  scanConfig        String       @default("{\"requestDelay\":500,\"userAgent\":\"default\",\"timeout\":30000,\"retryCount\":3}")
  verificationToken String?      // For domain ownership verification
  isVerified        Boolean      @default(false)
  lastScanAt        DateTime?
  riskScore         Int?
  nextScheduledScan DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scans             Scan[]
  violations        Violation[]
}

model Scan {
  id              String      @id @default(cuid())
  projectId       String
  status          String      @default("pending")
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  pagesScanned    Int         @default(0)
  violationsFound Int         @default(0)
  summary         String?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  violations      Violation[]
}

model Violation {
  id                String    @id @default(cuid())
  scanId            String
  projectId         String
  ruleId            String
  wcagCriteria      String?
  severity          String
  url               String
  elementSelector   String?
  elementHtml       String?
  description       String
  remediationCode   String?
  aiExplanation     String?
  aiConfidenceScore Float?
  status            String    @default("open")
  githubPrUrl       String?
  createdAt         DateTime  @default(now())
  fixedAt           DateTime?
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan              Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model GithubConnection {
  id             String       @id @default(cuid())
  orgId          String
  installationId String       @unique
  repositories   String       @default("[]")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String       @id @default(cuid())
  orgId        String
  action       String
  metadata     String       @default("{}")
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model WcagRule {
  id           String   @id @default(cuid())
  ruleId       String   @unique
  name         String
  description  String
  wcagCriteria String
  level        String
  category     String
  howToFix     String
  createdAt    DateTime @default(now())
}
