generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  plan                 String             @default("starter")
  subscriptionStatus   String             @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  dataRegion           String             @default("us")
  settings             String             @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  auditLogs            AuditLog[]
  githubConnections    GithubConnection[]
  projects             Project[]
  users                User[]
  teamInvites          TeamInvite[]
  customRoles          CustomRole[]
}

model User {
  id                   String       @id @default(cuid())
  orgId                String
  email                String       @unique
  name                 String?
  password             String?
  role                 String       @default("member")
  customRoleId         String?
  avatar               String?
  githubToken          String?
  githubLogin          String?
  emailVerifiedAt      DateTime?
  emailVerificationToken String?
  emailVerificationTokenExpiresAt DateTime?
  mfaSecret            String?
  mfaEnabledAt         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customRole           CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@index([orgId])
}

// Org-defined roles: an owner/admin can create roles with a subset of
// permissions and assign them to members. Custom roles layer on top of the
// built-in owner/admin/member tiers (member tier is the base).
model CustomRole {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Project {
  id                String           @id @default(cuid())
  orgId             String
  name              String
  url               String
  description       String?
  crawlConfig       String           @default("{\"maxPages\":100,\"excludePaths\":[],\"includeSubdomains\":false}")
  scanConfig        String           @default("{\"requestDelay\":500,\"userAgent\":\"default\",\"timeout\":30000,\"retryCount\":3}")
  verificationToken String?          // For domain ownership verification
  isVerified        Boolean          @default(false)
  lastScanAt        DateTime?
  riskScore         Int?
  nextScheduledScan DateTime?
  isActive          Boolean          @default(true)
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scans             Scan[]
  violations        Violation[]
  complianceReports ComplianceReport[]
  scheduledScans    ScheduledScan[]

  @@index([orgId, isActive])
  @@index([orgId, createdAt])
  @@index([isActive, nextScheduledScan])
  @@index([deletedAt])
}

model Scan {
  id              String      @id @default(cuid())
  projectId       String
  status          String      @default("pending")
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  pagesScanned    Int         @default(0)
  violationsFound Int         @default(0)
  summary         String?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  deletedAt       DateTime?
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  violations      Violation[]

  @@index([projectId, status])
  @@index([projectId, startedAt])
  @@index([status, startedAt])
  @@index([createdAt])
  @@index([deletedAt])
}

model Violation {
  id                String    @id @default(cuid())
  scanId            String
  projectId         String
  ruleId            String
  wcagCriteria      String?
  severity          String
  url               String
  elementSelector   String?
  elementHtml       String?
  description       String
  remediationCode   String?
  aiExplanation     String?
  aiConfidenceScore Float?
  status            String    @default("open")
  githubPrUrl       String?
  createdAt         DateTime  @default(now())
  fixedAt         DateTime?
  deletedAt       DateTime?
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan            Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([projectId, createdAt])
  @@index([scanId, severity])
  @@index([deletedAt])
}

model GithubConnection {
  id             String       @id @default(cuid())
  orgId          String
  installationId String       @unique
  repositories   String       @default("[]")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String       @id @default(cuid())
  orgId        String
  action       String
  metadata     String       @default("{}")
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, action])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model TeamInvite {
  id         String   @id @default(cuid())
  orgId      String
  email      String
  role       String   @default("member")
  token      String   @unique
  invitedBy  String?
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

model ComplianceReport {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  reportType      String   @default("wcag")
  format          String   @default("pdf")
  status          String   @default("pending")
  summary         String?
  metadata        String   @default("{}")
  dateRange       String   @default("{}")
  fileUrl         String?
  generatedAt     DateTime?
  expiresAt       DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([deletedAt])
}

model ScheduledScan {
  id             String   @id @default(cuid())
  projectId      String   @unique
  frequency      String   @default("weekly")
  cron           String   @default("0 2 * * 1")
  nextRunAt      DateTime
  lastRunAt      DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([isActive, nextRunAt])
}

model WcagRule {
  id           String   @id @default(cuid())
  ruleId       String   @unique
  name         String
  description  String
  wcagCriteria String
  level        String
  category     String
  howToFix     String
  createdAt    DateTime @default(now())
}

// Stripe at-least-once delivery — dedupe key so webhook replays are a no-op
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
